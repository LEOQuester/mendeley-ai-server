# Required for admin UI login
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: seed API keys on first run (comma-separated)
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=

# Server
PORT=8000
CORS_ORIGINS=chrome-extension://*

# Optional: persistent data dir (Railway volume mount path, e.g. /data)
MENDELEY_DATA_DIR=

# MySQL optional overrides (defaults are in app/mysql_store.py)
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
