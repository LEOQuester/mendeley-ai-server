# Optional: persistent data dir (Railway volume mount path, e.g. /data)
MENDELEY_DATA_DIR=

# MySQL (API keys + model lists survive redeploys)
MYSQL_HOST=primeict.lk
MYSQL_PORT=3306
MYSQL_USER=primeic1_mcq_tool_user
